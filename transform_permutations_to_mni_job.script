# Ex: sbatch transform_permutations_to_mni_job.script

module load ants/2.3.5
# ants/2.5.0 gives error:
#000: /N/soft/rhel8/ants/build/gnu-2.5.0/ITKv5/Modules/ThirdParty/HDF5/src/itkhdf5/src/H5T.c line 1888 in itk_H5Tcopy(): obj_id is not a datatype ID
#    major: Invalid arguments to routine
#    minor: Inappropriate type
# so use 2.3.5
module load fsl
#module load gnu-parallel

#subs_to_process="1"
