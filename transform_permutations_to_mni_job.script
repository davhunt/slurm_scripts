#sfolder="breakpoint_rts_unsmoothed_native_antsmask"
sfolder="breakpoint_rts_unsmoothed_native_antsmask_new_bps"

echo "starting"

#echo "$subs_to_process" | parallel -j $SLURM_CPUS_PER_TASK /N/slate/brainevo/Implicit_Learning/transform_permutations_to_mni.sh {} # this didn't work

#/N/slate/brainevo/Implicit_Learning/transform_permutations_to_mni.sh $subs_to_process

