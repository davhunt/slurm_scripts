#!/bin/bash
#SBATCH --account=r00172
#SBATCH --job-name=perms-breakpoint_RTs-native
#SBATCH --nodes=1-3
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=34
#SBATCH --mem=70G
#SBATCH --time=24:00:00
#SBATCH --output=/N/slate/brainevo/Implicit_Learning/Complex_seq_analysis/slurm-outs/perm100-bps-%j.out

# Usage: sbatch --export=ALL,subj=<subj #> run_permutations_job.script
# Run 100 permutations at atime, ~18 hours / 100 permutations x 10 CVs

module load matlab/2023b

if [[ -z $subj ]]; then
  echo "subject not specified, exiting."
  exit 1
fi

echo "running 100 permutations with 10 CV splits each on sub-$subj."
#echo "running 100 permutations with 5 CV splits each on sub-$subj."

#time matlab -nodisplay -nosplash -nodesktop -r "addpath('/N/slate/brainevo/Implicit_Learning/tdt_3.999I/decoding_toolbox/templates'); gng_permutations_parallel_all_splits_slate_durs_native($subj,100,10); exit;" > /dev/null 2>&1
#time matlab -nodisplay -nosplash -nodesktop -r "addpath('/N/slate/brainevo/Implicit_Learning/tdt_3.999I/decoding_toolbox/templates'); gng_permutations_parallel_all_splits_slate_durs_native($subj,100,5); exit;" > /dev/null 2>&1
#time matlab -nodisplay -nosplash -nodesktop -r "addpath('/N/slate/brainevo/Implicit_Learning/tdt_3.999I/decoding_toolbox/templates'); gng_permutations_parallel_all_splits_slate_durs_native($subj,100,5); exit;"
#time matlab -nodisplay -nosplash -nodesktop -r "addpath('/N/slate/brainevo/Implicit_Learning/tdt_3.999I/decoding_toolbox/templates'); gng_permutations_parallel_all_splits_slate_onsets_native($subj,100,5); exit;"
#time matlab -nodisplay -nosplash -nodesktop -r "addpath('/N/slate/brainevo/Implicit_Learning/tdt_3.999I/decoding_toolbox/templates'); gng_permutations_parallel_all_splits_slate_bp_rts_native($subj,100,5); exit;"
#time matlab -nodisplay -nosplash -nodesktop -r "addpath('/N/slate/brainevo/Implicit_Learning/tdt_3.999I/decoding_toolbox/templates'); gng_decoding_allparams($subj,100,5,'breakpoint_rts_unsmoothed_native'); exit;"
#time matlab -nodisplay -nosplash -nodesktop -r "addpath('/N/slate/brainevo/Implicit_Learning/tdt_3.999I/decoding_toolbox/templates'); gng_decoding_permutations($subj,100,5,'breakpoint_rts_unsmoothed_native'); exit;"
#time matlab -nodisplay -nosplash -nodesktop -r "addpath('/N/slate/brainevo/Implicit_Learning/tdt_3.999I/decoding_toolbox/templates'); gng_decoding_permutations($subj,100,5,'breakpoint_rts_unsmoothed_native_antsmask'); exit;"
#time matlab -nodisplay -nosplash -nodesktop -r "addpath('/N/slate/brainevo/Implicit_Learning/tdt_3.999I/decoding_toolbox/templates'); gng_decoding_permutations($subj,100,10,'breakpoint_rts_unsmoothed_native_antsmask'); exit;"
time matlab -nodisplay -nosplash -nodesktop -r "addpath('/N/slate/brainevo/Implicit_Learning/tdt_3.999I/decoding_toolbox/templates'); gng_decoding_permutations($subj,100,10,'breakpoint_rts_unsmoothed_native_antsmask_new_bps'); exit;"


echo "done!"
